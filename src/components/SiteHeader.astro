---
import { site, nav } from '../data/site';

interface Props {
  current: string;
}
const { current } = Astro.props;
---
<header class="site-header">
  <div class="bar">
    <a class="mark" href="/" aria-label="THIS IS GOGO 首页">{site.shortMark}</a>
    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { 'is-current': current === item.href }]}
            aria-current={current === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav">
      Menu
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="移动端主导航" hidden>
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={{ 'is-current': current === item.href }}
          aria-current={current === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
